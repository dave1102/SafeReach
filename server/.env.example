PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin SDK (service account) — paste the JSON contents into a
# single line, or point FIREBASE_SERVICE_ACCOUNT_PATH at a mounted file.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# AI provider — set one. Checked in this order: GROQ_API_KEY, then
# GEMINI_API_KEY, then OPENAI_API_KEY. Groq is OpenAI-compatible and fast —
# good default to get things running quickly.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
OPENAI_API_KEY=

# Places lookup (nearby hospitals/pharmacies/police).
# If GOOGLE_PLACES_API_KEY is set, Google Places is used; otherwise the
# server falls back to the free OpenStreetMap Overpass API (no key needed).
GOOGLE_PLACES_API_KEY=
